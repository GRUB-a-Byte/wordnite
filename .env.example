# Copy to .env.local and fill in. Both values are PUBLIC by design (they ship to the browser).
# Supabase → Project Settings → API → Project URL / anon (publishable) key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Realtime transport: "supabase" (default when the Supabase vars are set) or "local"
# (dev/test-only WebSocket relay started with `npm run relay`). Never use "local" in production.
# NEXT_PUBLIC_REALTIME_TRANSPORT=supabase
# NEXT_PUBLIC_LOCAL_RELAY_URL=ws://localhost:8787

# Optional. Set to "false" to stop mirroring opponents' in-progress typing (reduces Realtime messages, FR-3.6).
# NEXT_PUBLIC_DRAFT_MIRROR=true
